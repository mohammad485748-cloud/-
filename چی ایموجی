<script>

const questions = [

  ["🦁 + 🍌", "شیر موز"],
  ["☀️ + 🌻", "آفتابگردان"],
  ["🐝 + 🍯", "عسل"],
  ["🌙 + ⭐", "شب ستاره"],
  ["🐴 + 🥕", "اسب هویج"],
  ["🍎 + 🍰", "کیک سیب"],
  ["🐟 + 🍞", "ماهی"],
  ["🔥 + 🍗", "مرغ کبابی"],
  ["🌊 + 🏠", "خانه ساحلی"],
  ["🚗 + 🏠", "خانه ماشین"],
  ["🍕 + 🧀", "پیتزا"],
  ["🍦 + 🍫", "بستنی شکلاتی"],
  ["🐱 + 🏠", "خانه گربه"],
  ["🌧️ + ☂️", "چتر باران"],
  ["❄️ + ☕", "قهوه گرم"]
];

let level = 1;
let score = 0;
let record = Number(localStorage.getItem("emojiRecord") || 0);
let hintUsed = false;

document.getElementById("record").textContent = record;

function getQuestion() {

  if(level <= questions.length) {
    return questions[level - 1];
  }

  const emojis = [
    "🐶","🐱","🦁","🐼","🐸","🦊",
    "🐯","🐰","🐨","🐵","🐙","🦄",
    "🍎","🍌","🍕","🍔","🍰","🍉",
    "🚗","✈️","🏠","🌳","⭐","🌙",
    "☀️","🔥","❄️"
  ];

  const words = [
    "کتاب","مدرسه","دوچرخه","هواپیما",
    "درخت","رودخانه","کوه","دریا",
    "پیتزا","بستنی","تلفن","کامپیوتر",
    "بیمارستان","پلیس","آتش نشان",
    "فروشگاه","دوست","خانواده",
    "مسافرت","بازی"
  ];

  const count = Math.min(
    2 + Math.floor((level - 1) / 100),
    11
  );

  let result = [];

  for(let i=0;i<count;i++) {
    result.push(
      emojis[(level * 7 + i * 13) % emojis.length]
    );
  }

  return [
    result.join(" + "),
    words[(level * 11) % words.length]
  ];
}

function normalize(text) {

  return text
    .trim()
    .replace(/ي/g,"ی")
    .replace(/ك/g,"ک")
    .replace(/\s+/g," ")
    .toLowerCase();
}

function renderQuestion() {

  const q = getQuestion();

  document.getElementById("emojiQuestion").textContent = q[0];

  document.getElementById("level").textContent =
    level + " / 1000";

  document.getElementById("score").textContent = score;

  document.getElementById("progressBar").style.width =
    (level / 1000 * 100) + "%";

  document.getElementById("answer").value = "";

  document.getElementById("message").textContent = "";

  hintUsed = false;

  document.getElementById("answer").focus();
}

function checkAnswer() {

  const input =
    normalize(document.getElementById("answer").value);

  if(!input) {

    showMessage(
      "اول جواب را بنویس!",
      "wrong"
    );

    return;
  }

  const q = getQuestion();

  const correct = normalize(q[1]);

  if(
    input === correct ||
    input.includes(correct) ||
    correct.includes(input)
  ) {

    const points = hintUsed ? 5 : 10;

    score += points;

    if(score > record) {

      record = score;

      localStorage.setItem(
        "emojiRecord",
        record
      );

      document.getElementById("record")
        .textContent = record;
    }

    showMessage(
      "🎉 درست بود! +" + points + " امتیاز",
      "correct"
    );

    if(level < 1000) {

      level++;

      setTimeout(
        renderQuestion,
        700
      );

    } else {

      showMessage(
        "🏆 تبریک! هر ۱۰۰۰ مرحله را تمام کردی!",
        "correct"
      );
    }

  } else {

    showMessage(
      "❌ جواب اشتباه است؛ دوباره امتحان کن!",
      "wrong"
    );
  }
}

function showHint() {

  const q = getQuestion();

  hintUsed = true;

  const answer = q[1];

  const first =
    answer.substring(
      0,
      Math.max(1,Math.ceil(answer.length / 3))
    );

  showMessage(
    "💡 راهنما: جواب با «" + first + "...» شروع می‌شود.",
    ""
  );
}

function skipLevel() {

  if(level < 1000) {

    level++;

    renderQuestion();

  } else {

    showMessage(
      "🏁 این آخرین مرحله است.",
      ""
    );
  }
}

function showMessage(text,type) {

  const el =
    document.getElementById("message");

  el.textContent = text;

  el.className = type;
}

document
  .getElementById("answer")
  .addEventListener("keydown",function(e){

    if(e.key === "Enter") {
      checkAnswer();
    }

  });

renderQuestion();

</script>

